# Base URL of the backend API. Leave empty in local dev to use the Vite
# proxy (see vite.config.ts) which forwards /api to http://localhost:4000.
VITE_API_BASE_URL=

# The email of the seeded admin account (backend/prisma/seed.ts). The admin
# login page at /site/in/admin only asks for a password — it signs in with
# this fixed account email under the hood, reusing the same secure,
# rate-limited, lockout-protected auth as every other login.
VITE_ADMIN_EMAIL=admin@prakritihealthcare.com
