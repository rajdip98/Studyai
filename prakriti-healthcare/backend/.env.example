# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://prakriti:prakriti@localhost:5432/prakriti_healthcare
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie signing secret (separate from JWT secrets)
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# Password reset / email verification token TTL
EMAIL_TOKEN_TTL_MIN=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me
SMTP_FROM="Prakriti Healthcare <no-reply@prakritihealthcare.com>"

RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

SENTRY_DSN=

# S3-compatible object storage for product images
S3_ENDPOINT=
S3_BUCKET=prakriti-healthcare-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# CDN base URL served in front of the S3 bucket / static assets
CDN_BASE_URL=https://cdn.prakritihealthcare.com
