# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173

# Base URL of the deployed frontend — used to build the clickable links sent
# in verification/password-reset emails (e.g. FRONTEND_URL/reset-password?token=...)
FRONTEND_URL=http://localhost:5173

# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> URI). Falls back to local Postgres for docker-compose dev.
DATABASE_URL=postgresql://prakriti:prakriti@localhost:5432/prakriti_healthcare
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie signing secret (separate from JWT secrets)
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# Password reset / email verification token TTL
EMAIL_TOKEN_TTL_MIN=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me
SMTP_FROM="Prakriti Healthcare <no-reply@prakritihealthcare.com>"

RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

SENTRY_DSN=

# Supabase Storage (admin panel uploads: banners/posters/payment QR/product
# images), bucket "site-assets" (public, 5MB limit, png/jpeg/webp only).
# SUPABASE_URL: Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role secret.
# NEVER expose the service_role key to the frontend or commit it — it
# bypasses Row Level Security entirely.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional CDN placed in front of Supabase Storage / static assets
CDN_BASE_URL=
